{
  "name": "netmind-mcp",
  "displayName": "netMind MCP Server",
  "description": "Model Context Protocol server that lets Claude Code, AgentX Workmate, Codex or Cursor delegate browser tasks to a running netMind Extension, in the user's real, already-authenticated browser session.",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "netmind-mcp": "dist/index.js"
  },
  "license": "MIT",
  "homepage": "https://github.com/astralxkienlt/agentx-webmate/tree/main/mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/astralxkienlt/agentx-webmate.git",
    "directory": "mcp-server"
  },
  "scripts": {
    "build": "npm run gen:brand && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/answers.test.mjs test/brand.test.mjs test/bridge.test.mjs test/build-skill.test.mjs test/catalog.test.mjs test/config.test.mjs test/runs-request-timeout.test.mjs test/runs-timeout.test.mjs test/skill-bundle.test.mjs test/stdio-shutdown.test.mjs",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "build:skill": "node scripts/build-skill.mjs",
    "gen:brand": "node scripts/gen-brand.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "netmind",
    "browser-agent",
    "browser-automation",
    "claude-code",
    "agentx-workmate",
    "codex",
    "cursor"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.28.1",
    "typescript": "^5.5.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
