# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@0.0.0.0:5432/netmind_extension
SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# Sub-path the reverse proxy serves this API under. A PATH, never a URL — the
# backend does not need to know its own domain. nginx forwards the full public
# path unchanged and the routers mount under it. Empty = served at root.
# /health always stays at the root so the container healthcheck bypasses nginx.
# API_BASE_PATH=/netmind-extension
API_BASE_PATH=

CORS_ORIGINS=

# ── Identity (Viettel SSO wrapper) ───────────────────────────────────────────.
OIDC_ISSUER=https://netmind.viettel.vn/sso-wrapper
OIDC_CLIENT_ID=netmind-extension
OIDC_SCOPES=openid profile email
# Extra audiences to accept alongside OIDC_CLIENT_ID, comma-separated. Empty
# normally; set it during a client-id migration so both ids work at once and no
# flag day is needed. Remove it once every client has moved.
OIDC_EXTRA_AUDIENCES=

# The ONE algorithm this deployment accepts. Pinning it is the whole defence
# against algorithm confusion, and it works both ways: a token arriving under
# any other alg is refused before a key is selected. `none` is never accepted.
# The Viettel SSO wrapper signs with HS256.
OIDC_ID_TOKEN_ALG=HS256

# How a bearer gets verified. Set this and the issuer itself is asked who the
# token belongs to; leave it empty and the signature is checked here instead.
#
# The Viettel SSO wrapper needs it set: it signs HS256 with a secret held only
# by the wrapper process, serves no JWKS, and registers no clients — there is no
# key to obtain and nothing local to check. In this mode the token's own claims
# decide nothing: identity comes from the userinfo response, and `aud` is
# ignored because the wrapper echoes back whatever client_id it was sent.
OIDC_USERINFO_ENDPOINT=
# How long a verified answer is trusted. One sign-in makes several calls, so a
# short window removes most round trips. It is also how long a token revoked at
# the issuer keeps working here, so do not make it long.
OIDC_USERINFO_CACHE_SECONDS=60

# Only for the local-verification mode (OIDC_USERINFO_ENDPOINT empty) with a
# symmetric alg. Unused, and best left empty, in userinfo mode.
OIDC_SHARED_SECRET=

JWKS_URL=
JWKS_CACHE_SECONDS=600
JWT_LEEWAY_SECONDS=60

# The wrapper publishes no /.well-known/openid-configuration, so the endpoints
# discovery would have supplied are named here and handed to clients by
# GET /api/auth/providers. Both or neither.
OIDC_AUTHORIZATION_ENDPOINT=https://netmind.viettel.vn/sso-wrapper/authorize
OIDC_TOKEN_ENDPOINT=https://netmind.viettel.vn/sso-wrapper/token

# ── LiteLLM gateway ──────────────────────────────────────────────────────────
# Where THIS SERVICE reaches the gateway admin API (/key/generate,
# /model/info). Internal is fine and usually right. No trailing /v1.
LITELLM_BASE_URL=
# Where the EXTENSION is told to send inference. Set it whenever the admin
# API and the public inference host are not the same URL — a browser cannot
# reach an internal http:// address, and an extension page is a secure
# origin so it refuses one outright. Empty = reuse LITELLM_BASE_URL.
# No trailing /v1 here either: the client appends it.
LITELLM_PUBLIC_BASE_URL=
LITELLM_ADMIN_KEY=
LITELLM_TEAM_ID=

# Alias prefix for minted keys: "[{prefix}][{email}]". A label for the
# LiteLLM console only — keys are always deleted by token, never by alias.
# Keys are minted with no model list of their own: each key reaches exactly
# what the gateway grants it (the team's models when LITELLM_TEAM_ID is set),
# so granting a model to the team reaches every existing key with no re-mint.
KEY_ALIAS_PREFIX=netmind-extension

# ── Key encryption at rest ───────────────────────────────────────────────────
BRAIN_KEK=
BRAIN_KEK_ID=k1

BRAIN_KEK_PREVIOUS=
BRAIN_KEK_PREVIOUS_ID=

# ── Telemetry ingest ─────────────────────────────────────────────────────────
INGEST_AUTH_KEY=

# ── Database pool ────────────────────────────────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_DISABLE_POOLING=false

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=30

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
