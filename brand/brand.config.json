{
  "product": {
    "name": "netMind Extension",
    "shortName": "netMind",
    "slug": "netmind-extension",
    "description": "AI browser agent — chat with pages, automate tasks, multi-provider LLM support.",
    "homepage": "https://github.com/astralxkienlt/agentx-webmate",
    "firefoxId": "netmind-extension@astralx.com.vn"
  },

  "services": {
    "secondBrainBaseUrl": "https://brain.dev-server.cloud/",
    "litellmBaseUrl": "https://aigw.dev-server.cloud/",
    "oidcIssuer": "https://agentx.astralx.com.vn/auth/realms/agent-hub",
    "oidcClientId": "agentx-workmate",
    "oidcScopes": "openid profile email",
    "oidcRedirectUris": [
      "http://127.0.0.1:47821/callback",
      "http://127.0.0.1:47822/callback",
      "http://127.0.0.1:47823/callback"
    ]
  },

  "replacements": [
    {
      "_why": "Temporarily shield upstream API header names from display-name replacement.",
      "from": "X-WebBrain-",
      "to": "X-__AGENTX_UPSTREAM_HEADER__-",
      "only": ["src/providers/openai.js", "src/profile-sync.js"]
    },
    {
      "_why": "Display name in UI and skill text. Guards keep it out of identifiers and protocol tokens such as ensureWebBrainGroup and X-WebBrain-Help-Improve.",
      "regex": "(?<![A-Za-z0-9_$])WebBrain(?![A-Za-z0-9_$])",
      "to": "netMind Extension",
      "except": ["vendor/**"]
    },
    {
      "_why": "Restore upstream API header names after display-name replacement.",
      "from": "X-__AGENTX_UPSTREAM_HEADER__-",
      "to": "X-WebBrain-",
      "only": ["src/providers/openai.js", "src/profile-sync.js"]
    },
    {
      "_why": "Lowercase brand name inside translated sentences. Scoped to locale files only; the lookarounds keep it off webbrain.one, webbrain_note and webbrain-tools.",
      "regex": "(?<![A-Za-z0-9_$\\-./])webbrain(?![A-Za-z0-9_$\\-]|\\.one)",
      "to": "netMind Extension",
      "only": ["src/ui/locales/**", "src/selection-shortcut-i18n.js"]
    },
    {
      "_why": "Fallback prefix for downloaded screenshot filenames.",
      "from": "|| 'webbrain'",
      "to": "|| 'netmind-extension'",
      "only": ["src/ui/sidepanel.js"]
    },
    {
      "_why": "User-visible export and capture filenames.",
      "regex": "webbrain-(run|recording|config|traces|trace|chat|user-memory|screenshot|visible-media|fullpage)-",
      "to": "netmind-extension-$1-",
      "only": [
        "src/ui/sidepanel.js",
        "src/ui/settings.js",
        "src/ui/traces.js",
        "src/ui/history.js",
        "src/ui/staged-screenshot-store.js",
        "src/recorder/host.js",
        "src/agent/agent.js"
      ]
    },
    {
      "_why": "Fallback names for recordings and staged screenshots.",
      "regex": "webbrain-(recording|screenshot\\.png)(?=['\"])",
      "to": "netmind-extension-$1",
      "only": [
        "src/ui/sidepanel.js",
        "src/ui/staged-screenshot-store.js",
        "src/recorder/host.js"
      ]
    },
    {
      "_why": "Branded workflow exports while continuing to import legacy WebBrain and AgentX WebMate workflow files.",
      "from": "return `${stem}.webbrain-workflow.json`;",
      "to": "return `${stem}.netmind-extension-workflow.json`;",
      "only": ["src/ui/sidepanel.js"]
    },
    {
      "_why": "Accept new, previous-brand, and legacy workflow file extensions.",
      "from": ".json,.webbrain-workflow.json,application/json",
      "to": ".json,.netmind-extension-workflow.json,.agentx-webmate-workflow.json,.webbrain-workflow.json,application/json",
      "only": ["src/ui/sidepanel.js"]
    },
    {
      "_why": "Send reviews and feedback to the product repository until store listings are available.",
      "regex": "https://(?:chromewebstore\\.google\\.com/detail/webbrain/ljhijonmfahplgbbacgcfnaihbjljhhb|addons\\.mozilla\\.org/en-US/firefox/addon/webbrain/)",
      "to": "https://github.com/astralxkienlt/agentx-webmate",
      "only": ["src/ui/store-review-prompt.js"]
    },
    {
      "_why": "Do not show a misleading store-review prompt before netMind Extension has official listings.",
      "from": "export const MIN_SUCCESSFUL_TASKS = 3;",
      "to": "export const MIN_SUCCESSFUL_TASKS = Number.POSITIVE_INFINITY;",
      "only": ["src/ui/store-review-prompt.js"]
    },
    {
      "_why": "Send feedback to the product issue tracker.",
      "from": "https://github.com/webbrain-one/webbrain/issues/new",
      "to": "https://github.com/astralxkienlt/agentx-webmate/issues/new",
      "only": ["src/ui/store-review-prompt.js"]
    },
    {
      "_why": "Point the in-app documentation link to this repository's documentation.",
      "from": "https://webbrain.one/docs",
      "to": "https://github.com/astralxkienlt/agentx-webmate/tree/main/docs",
      "only": ["src/ui/settings.html"]
    },
    {
      "_why": "Avoid promoting the upstream brand in localized social-share copy.",
      "regex": "https://webbrain\\.one(?=['\"])",
      "to": "https://github.com/astralxkienlt/agentx-webmate",
      "only": ["src/ui/locales/**"]
    }
  ],

  "preserve": [
    "webbrain.one/.well-known",
    "webbrain_traces",
    "X-WebBrain-Client",
    "X-WebBrain-Device-Id",
    "X-WebBrain-Help-Improve",
    "X-WebBrain-Sync-Verifier",
    "WEBBRAIN_CLOUD_PROVIDER_ID",
    "WEBBRAIN_DEVICE_GUID_KEY",
    "HELP_IMPROVE_WEBBRAIN_KEY",
    "helpImproveWebBrain",
    "webbrainVersion",
    "webBrainGroupByWindow"
  ],

  "features": {
    "exclude": [
      "README.md",
      "ARCHITECTURE.md",
      "icons/providers/SOURCES.md",
      "vendor/**/README.md"
    ]
  },

  "manifestOverrides": {
    "all": {}
  },

  "audit": {
    "token": "webbrain"
  }
}
