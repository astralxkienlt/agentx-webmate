 // --- Vision Model ---
+
+/**
+ * Renders the Cloud vision + transcription pickers into the Multimodal tab.
+ *
+ * When the gateway is connected it owns both sidecars, so the hand-rolled
+ * OpenAI-compatible endpoints below each panel are disabled rather than
+ * removed: the user keeps seeing what they had configured before signing in,
+ * and gets it back on sign-out.
+ */
+function renderAgentXCloudMultimodalSettings() {
+  const connected = agentxCloudController.isConnected();
+  const panels = [
+    {
+      rootId: 'agentx-cloud-vision-panel',
+      cardId: 'vision-card',
+      managedClass: 'agentx-cloud-vision-managed',
+      fieldsId: 'vision-endpoint-fields',
+      render: () => agentxCloudController.renderVision(),
+      bind: (root) => agentxCloudController.bindVision(root),
+    },
+    {
+      rootId: 'agentx-cloud-transcription-panel',
+      cardId: 'transcription-card',
+      managedClass: 'agentx-cloud-transcription-managed',
+      fieldsId: 'transcription-endpoint-fields',
+      render: () => agentxCloudController.renderTranscription(),
+      bind: (root) => agentxCloudController.bindTranscription(root),
+    },
+  ];
+  for (const panel of panels) {
+    const root = document.getElementById(panel.rootId);
+    if (!root) continue;
+    root.innerHTML = panel.render();
+    panel.bind(root);
+    document.getElementById(panel.cardId)?.classList.toggle(panel.managedClass, connected);
+    const fields = document.getElementById(panel.fieldsId);
+    if (fields) fields.disabled = connected;
+  }
+}
 
