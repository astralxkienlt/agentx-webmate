+// AgentX Skill Hub provenance (brand layer, plan Phase 4 item 2). A record
+// installed from the hub keeps the slug, the version and the content hash it
+// was rendered from, so hub-sync can tell "same version" from "newer on the
+// hub"; an edited copy keeps them as its origin while sourceType becomes 'text'.
+const HUB_SLUG_RE = /^[a-z0-9]+(?:-[a-z0-9]+)*(?:\/[a-z0-9]+(?:-[a-z0-9]+)*)?$/;
+function normalizeHubProvenance(item) {
+  const slug = cleanSingleLine(item?.hubSlug).slice(0, 160);
+  if (!HUB_SLUG_RE.test(slug)) return null;
+  return {
+    hubSlug: slug,
+    hubVersion: cleanSingleLine(item.hubVersion).slice(0, 64),
+    contentHash: cleanSingleLine(item.contentHash).slice(0, 128),
+  };
