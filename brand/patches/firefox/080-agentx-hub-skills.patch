+// AgentX Skill Hub provenance (brand layer, plan Phase 4 item 2). A record
+// installed from the hub keeps the slug, the version and the content hash it
+// was rendered from, so hub-sync can tell "same version" from "newer on the
+// hub", plus the hash of its own stored content (renderHash) so hub-sync can
+// tell a copy changed outside the extension from the render it installed
+// (plan §8 decision 9). A copy edited by hand before hub records became
+// read-only keeps them as its origin while sourceType is 'text'; a copy made
+// with "Fork to edit" carries forkedFrom instead and no hub fields.
+const HUB_SLUG_RE = /^[a-z0-9]+(?:-[a-z0-9]+)*(?:\/[a-z0-9]+(?:-[a-z0-9]+)*)?$/;
+const HUB_HASH_RE = /^sha256:[0-9a-f]{64}$/;
+function normalizeHubProvenance(item) {
+  const slug = cleanSingleLine(item?.hubSlug).slice(0, 160);
+  if (!HUB_SLUG_RE.test(slug)) return null;
+  const renderHash = cleanSingleLine(item.renderHash);
+  return {
+    hubSlug: slug,
+    hubVersion: cleanSingleLine(item.hubVersion).slice(0, 64),
+    contentHash: cleanSingleLine(item.contentHash).slice(0, 128),
+    renderHash: HUB_HASH_RE.test(renderHash) ? renderHash : '',
+  };
+}
+function normalizeForkProvenance(item) {
+  const slug = cleanSingleLine(item?.forkedFrom?.slug).slice(0, 160);
+  if (!HUB_SLUG_RE.test(slug)) return null;
+  return { forkedFrom: { slug, version: cleanSingleLine(item.forkedFrom.version).slice(0, 64) } };
+}
