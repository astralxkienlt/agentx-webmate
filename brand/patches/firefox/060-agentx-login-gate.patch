+// ─── AgentX sign-in gate ───────────────────────────────────────────
+// The panel is unusable until the account is signed in and the managed cloud
+// provider holds a live key, so this runs before the product tour: onboarding
+// asks which model to use, and by then the answer is already settled.
+const agentxSignedIn = (function initAgentXLoginGate() {
+  const root = document.getElementById('agentx-login-gate');
+  if (!root) return Promise.resolve();
+  try {
+    const gate = createAgentXLoginGate({
+      api: globalThis.browser,
+      root,
+      appRoot: document.getElementById('app'),
+      locale: getLocale,
+      sendToBackground,
+    });
+    return gate.start();
+  } catch (error) {
+    // A gate that cannot even be constructed would lock the panel forever.
+    // Surface it and let the panel through rather than bricking the install.
+    console.error('[AgentX] sign-in gate unavailable:', error);
+    root.classList.add('hidden');
+    return Promise.resolve();
+  }
+})();
+
 // ─── Onboarding (first-launch wizard) ───────────────────────────────
